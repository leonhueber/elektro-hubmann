---
import { IconMenu2, IconX } from '@tabler/icons-react';
---

<details class="mobile-navigation">
  <summary aria-label="Hauptmenü öffnen oder schließen">
    <IconMenu2
      className="mobile-navigation__icon--open"
      size={22}
      aria-hidden="true"
    />
    <IconX
      className="mobile-navigation__icon--close"
      size={22}
      aria-hidden="true"
    />
    <span>Menü</span>
  </summary>
  <nav aria-label="Mobile Hauptnavigation">
    <a href="#leistungen">Leistungen</a>
    <a href="#projekte">Projekte</a>
    <a href="#unternehmen">Unternehmen</a>
    <a href="#kontakt">Kontakt</a>
  </nav>
</details>

<script is:inline>
  document.querySelectorAll('.mobile-navigation').forEach((menu) => {
    window.addEventListener('hashchange', () => menu.removeAttribute('open'));

    document.addEventListener('click', (event) => {
      if (
        menu.open &&
        event.target instanceof Node &&
        !menu.contains(event.target)
      ) {
        menu.removeAttribute('open');
      }
    });
  });
</script>
