---
import { withBase } from '../lib/url';
import { company } from '../config/site';
import MobileNavigation from './MobileNavigation.astro';

interface Props {
  pagePath: string;
}

const { pagePath } = Astro.props;
---

<div class="info-bar">
  <div class="info-bar__inner">
    <a class="info-bar__emergency" href={company.emergencyHref}>
      <span>Störungsdienst</span>
      <strong>{company.emergency}</strong>
    </a>
    <a href={`${pagePath}#fachhandel`}>
      <span>Fachgeschäft & Öffnungszeiten</span>
      <small>{company.shopHours}</small>
    </a>
  </div>
</div>

<header class="site-header">
  <a class="brand" href={pagePath} aria-label="Elektro Hubmann Startseite">
    <img
      src={withBase('/logo-elektrotechnik-hubmann.png')}
      width="287"
      height="78"
      alt="Elektrotechnik Hubmann"
    />
  </a>

  <nav class="main-nav" aria-label="Hauptnavigation">
    <a href={`${pagePath}#leistungen`}>Leistungen</a>
    <a href={`${pagePath}#projekte`}>Projekte</a>
    <a href={`${pagePath}#unternehmen`}>Unternehmen</a>
    <a href={`${pagePath}#kontakt`}>Kontakt</a>
  </nav>

  <div class="header-actions">
    <a
      class="button button--small header-cta"
      href={`${pagePath}#projektanfrage`}
    >
      <span class="header-cta__full">Projekt anfragen</span>
      <span class="header-cta__short">Anfragen</span>
    </a>
    <MobileNavigation />
  </div>
</header>
