---
import '@fontsource-variable/inter/index.css';
import '@fontsource-variable/inter-tight/index.css';
import HouseStory from './g/HouseStory';
import StaticHouseChapters from './g/StaticHouseChapters.astro';
import VariantGHeader from './g/VariantGHeader.astro';
import VariantGFooter from './g/VariantGFooter.astro';
import { company, projects } from '../../config/site';
import '../../styles/variant-g.css';

const baseUrl = import.meta.env.BASE_URL;
---

<VariantGHeader baseUrl={baseUrl} />
<main id="hauptinhalt" class="g-main">
  <h1 class="sr-only">
    Elektroinstallationen für Neubau, Sanierung und Gewerbe
  </h1>

  <div class="g-anchor-section" id="leistungen">
    <HouseStory
      baseUrl={baseUrl}
      client:media="(prefers-reduced-motion: no-preference)"
    />
    <StaticHouseChapters baseUrl={baseUrl} />
  </div>
  <noscript>
    <style is:inline>
      .g-story {
        display: none;
      }
      .g-static-story {
        display: block;
      }
    </style>
  </noscript>

  <section class="g-projects" id="projekte" aria-labelledby="g-projects-title">
    <div class="g-section-heading">
      <p class="g-eyebrow">Aus der Praxis</p>
      <h2 id="g-projects-title">Was wir umsetzen.</h2>
      <p>
        Von Wohnbau und Sanierung bis zu Gewerbe, Photovoltaik und vernetzter
        Gebäudetechnik: Lösungen, die zum Gebäude und seiner Nutzung passen.
      </p>
    </div>
    <div class="g-project-list">
      {
        projects.map((project, index) => (
          <article class="g-project-row">
            <div class="g-project-image">
              <img
                src={`${baseUrl}${project.image.replace(/^\//, '')}`}
                width={project.width}
                height={project.height}
                alt={project.alt}
                loading="lazy"
                decoding="async"
              />
            </div>
            <div>
              <span>0{index + 1}</span>
              <h3>{project.type}</h3>
              <p>{project.description}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section
    class="g-company-teaser"
    id="unternehmen"
    aria-labelledby="g-company-title"
  >
    <div>
      <p class="g-eyebrow">Seit 1972</p>
      <h2 id="g-company-title">
        Regional verwurzelt. Persönlich verantwortlich.
      </h2>
    </div>
    <div>
      <p>
        Elektro Hubmann ist ein Familienbetrieb aus Weißbriach. Über 50 Jahre
        Erfahrung, kurze Wege und ein persönlicher Ansprechpartner prägen unsere
        Arbeit.
      </p>
      <a class="g-outline-button" href="#kontakt">
        Persönlich Kontakt aufnehmen →
      </a>
    </div>
    <div class="g-facts" aria-label="Unternehmensdaten">
      <div>
        <strong>1972</strong>
        <span>Gründungsjahr</span>
      </div>
      <div>
        <strong>50+</strong>
        <span>Jahre Erfahrung</span>
      </div>
      <div>
        <strong>Weißbriach</strong>
        <span>Regionaler Standort</span>
      </div>
    </div>
  </section>

  <section
    class="g-company-teaser g-shop-section"
    id="fachhandel"
    aria-labelledby="g-shop-title"
  >
    <div>
      <p class="g-eyebrow">Fachgeschäft · Weißbriach</p>
      <h2 id="g-shop-title">Persönliche Beratung direkt vor Ort.</h2>
    </div>
    <div>
      <p>{company.address}</p>
      <p>{company.shopHours}</p>
      <div class="g-inline-actions">
        <a class="g-outline-button" href={company.phoneHref}>Jetzt anrufen →</a>
        <a
          class="g-text-link"
          href="https://www.google.com/maps/dir/?api=1&destination=Weißbriach+94%2C+9622+Weißbriach"
          target="_blank"
          rel="noreferrer"
        >
          Route planen ↗
        </a>
      </div>
    </div>
  </section>

  <section
    class="g-contact-band"
    id="kontakt"
    aria-labelledby="g-contact-title"
  >
    <div class="g-contact-intro">
      <p class="g-eyebrow">Kontakt</p>
      <h2 id="g-contact-title">Ihr Projekt beginnt mit einem Gespräch.</h2>
      <p>
        Kein Formular und keine Warteschleife: Rufen Sie uns an oder schreiben
        Sie uns direkt eine E-Mail. Für Störungen und Fragen zum Fachgeschäft
        finden Sie hier den passenden Kontakt.
      </p>
    </div>
    <div class="g-contact-grid">
      <article class="g-contact-card">
        <p class="g-contact-kicker">Projekt &amp; Allgemeines</p>
        <h3>Direkt mit uns sprechen.</h3>
        <p>
          Für neue Projekte, bestehende Anlagen und allgemeine Fragen erreichen
          Sie uns telefonisch oder per E-Mail.
        </p>
        <a class="g-contact-primary" href={company.phoneHref}>
          {company.phone}
          <span aria-hidden="true">→</span>
        </a>
        <a class="g-contact-secondary" href={company.emailHref}>
          {company.email}
        </a>
      </article>
      <article class="g-contact-card g-contact-card--emergency">
        <p class="g-contact-kicker">Störungsdienst</p>
        <h3>Wenn Technik ausfällt.</h3>
        <p>
          Für Störungen steht Ihnen unsere separate Servicenummer zur Verfügung.
        </p>
        <a class="g-contact-primary" href={company.emergencyHref}>
          {company.emergency}
          <span aria-hidden="true">→</span>
        </a>
      </article>
      <article class="g-contact-card">
        <p class="g-contact-kicker">Fachgeschäft</p>
        <h3>Persönlich in Weißbriach.</h3>
        <address>{company.address}</address>
        <p>{company.shopHours}</p>
        <a
          class="g-contact-secondary"
          href="https://www.google.com/maps/dir/?api=1&destination=Weißbriach+94%2C+9622+Weißbriach"
          target="_blank"
          rel="noreferrer"
        >
          Route planen ↗
        </a>
      </article>
    </div>
  </section>
</main>
<VariantGFooter baseUrl={baseUrl} />
