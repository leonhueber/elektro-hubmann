---
import '@fontsource-variable/inter/index.css';
import '@fontsource-variable/inter-tight/index.css';
import HouseStory from './g/HouseStory';
import StaticHouseChapters from './g/StaticHouseChapters.astro';
import VariantGHeader from './g/VariantGHeader.astro';
import VariantGFooter from './g/VariantGFooter.astro';
import { company, projects } from '../../config/site';
import '../../styles/variant-g.css';

const baseUrl = import.meta.env.BASE_URL;
const openingHours = [
  { day: 'Montag', morning: '09:00–12:00', afternoon: '15:00–17:30' },
  { day: 'Dienstag', morning: '09:00–12:00', afternoon: '15:00–17:30' },
  {
    day: 'Mittwoch',
    morning: '09:00–12:00',
    afternoon: 'Nachmittags geschlossen',
  },
  { day: 'Donnerstag', morning: '09:00–12:00', afternoon: '15:00–17:30' },
  {
    day: 'Freitag',
    morning: '09:00–12:00',
    afternoon: 'Nachmittags geschlossen',
  },
] as const;
---

<VariantGHeader baseUrl={baseUrl} />
<main id="hauptinhalt" class="g-main">
  <h1 class="sr-only">
    Elektroinstallationen für Neubau, Sanierung und Gewerbe
  </h1>

  <div class="g-anchor-section" id="leistungen">
    <HouseStory
      baseUrl={baseUrl}
      client:media="(prefers-reduced-motion: no-preference)"
    />
    <StaticHouseChapters baseUrl={baseUrl} />
  </div>
  <noscript>
    <style is:inline>
      .g-story {
        display: none;
      }
      .g-static-story {
        display: block;
      }
    </style>
  </noscript>

  <section class="g-projects" id="projekte" aria-labelledby="g-projects-title">
    <div class="g-section-heading">
      <p class="g-eyebrow">Aus der Praxis</p>
      <h2 id="g-projects-title">Was wir umsetzen.</h2>
      <p>
        Von Wohnbau und Sanierung bis zu Gewerbe, Photovoltaik und vernetzter
        Gebäudetechnik: Lösungen, die zum Gebäude und seiner Nutzung passen.
      </p>
    </div>
    <div class="g-project-list">
      {
        projects.map((project, index) => (
          <article class="g-project-row">
            <div class="g-project-image">
              <img
                src={`${baseUrl}${project.image.replace(/^\//, '')}`}
                width={project.width}
                height={project.height}
                alt={project.alt}
                loading="lazy"
                decoding="async"
              />
            </div>
            <div>
              <span>0{index + 1}</span>
              <h3>{project.type}</h3>
              <p>{project.description}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section
    class="g-company-teaser g-company-section"
    id="unternehmen"
    aria-labelledby="g-company-title"
  >
    <span class="g-company-year" aria-hidden="true">1972</span>
    <div class="g-company-heading">
      <p class="g-eyebrow g-company-eyebrow">Seit 1972</p>
      <h2 id="g-company-title">
        <span>Regional verwurzelt.</span>
        <span>Persönlich</span>
        <span>verantwortlich.</span>
      </h2>
    </div>
    <div class="g-company-copy">
      <p>
        Elektro Hubmann ist ein Familienbetrieb aus Weißbriach. Über 50 Jahre
        Erfahrung, kurze Wege und ein persönlicher Ansprechpartner prägen unsere
        Arbeit.
      </p>
      <a class="g-outline-button" href="#kontakt">
        Persönlich Kontakt aufnehmen →
      </a>
    </div>
    <div class="g-facts" aria-label="Unternehmensdaten">
      <div>
        <strong>1972</strong>
        <span>Gründungsjahr</span>
      </div>
      <div>
        <strong>50+</strong>
        <span>Jahre Erfahrung</span>
      </div>
      <div>
        <strong>Weißbriach</strong>
        <span>Regionaler Standort</span>
      </div>
    </div>
  </section>

  <section
    class="g-company-teaser g-shop-section"
    id="fachhandel"
    aria-labelledby="g-shop-title"
  >
    <div class="g-shop-intro">
      <p class="g-eyebrow">Fachgeschäft · Weißbriach</p>
      <h2 id="g-shop-title">
        <span>Persönliche</span>
        <span>Beratung direkt vor</span>
        <span>Ort.</span>
      </h2>
      <p class="g-shop-address">{company.address}</p>
      <div class="g-shop-actions">
        <a class="g-outline-button" href={company.phoneHref}>Jetzt anrufen →</a>
        <a
          class="g-text-link"
          href="https://www.google.com/maps/dir/?api=1&destination=Weißbriach+94%2C+9622+Weißbriach"
          target="_blank"
          rel="noreferrer"
        >
          Route planen ↗
        </a>
      </div>
    </div>
    <div class="g-shop-hours-panel">
      <table class="g-opening-hours">
        <caption class="sr-only">Öffnungszeiten des Fachgeschäfts</caption>
        <tbody>
          {
            openingHours.map(({ day, morning, afternoon }) => (
              <tr data-day={day.toLocaleLowerCase('de-AT')}>
                <th scope="row">{day}</th>
                <td>{morning}</td>
                <td
                  class:list={{
                    'is-closed': afternoon.includes('geschlossen'),
                  }}
                >
                  {afternoon}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>
</main>
<VariantGFooter baseUrl={baseUrl} />

<script>
  const currentWeekday = new Intl.DateTimeFormat('de-AT', {
    weekday: 'long',
    timeZone: 'Europe/Vienna',
  })
    .format(new Date())
    .toLocaleLowerCase('de-AT');

  document
    .querySelectorAll<HTMLTableRowElement>('.g-opening-hours tr[data-day]')
    .forEach((row) => {
      row.classList.toggle('is-today', row.dataset.day === currentWeekday);
    });
</script>
