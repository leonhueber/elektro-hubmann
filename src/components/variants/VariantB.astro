---
import HomeSections from '../HomeSections.astro';
import SiteFooter from '../SiteFooter.astro';
import SiteHeader from '../SiteHeader.astro';
import { withBase } from '../../lib/url';

const pagePath = Astro.url.pathname;
---

<SiteHeader pagePath={pagePath} />

<main id="hauptinhalt">
  <section class="hero hero--b">
    <div class="hero__copy">
      <span class="eyebrow">Elektrotechnik / Planung / Service</span>
      <h1>Elektroinstallationen für Neubau, Sanierung und Gewerbe.</h1>
      <p>
        Von der Planung bis zur fachgerechten Ausführung – in Gitschtal,
        Hermagor und am Weißensee.
      </p>
      <div class="button-row">
        <a class="button" href="#projektanfrage">Projekt anfragen</a>
        <a class="text-link" href="#leistungen">Leistungen ansehen →</a>
      </div>
    </div>
    <div class="hero__media technical-media">
      <img
        src={withBase('/images/legacy-placeholders/hubmann-slider-1.jpg')}
        alt="Detailaufnahme eines elektrischen Verteilers"
        width="1920"
        height="1277"
      />
      <div class="technical-media__label" aria-hidden="true">
        <span>EH / 1972</span>
        <strong>PLAN → BAU → SERVICE</strong>
      </div>
    </div>
  </section>

  <HomeSections />
</main>

<SiteFooter />
