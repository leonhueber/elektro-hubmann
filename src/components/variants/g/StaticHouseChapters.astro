---
import {
  VERSION_G_STORY_CHAPTERS,
  versionGStoryAssetUrl,
} from '../../../config/version-g-story-assets';

interface Props {
  baseUrl: string;
}
const { baseUrl } = Astro.props;
const chapters = VERSION_G_STORY_CHAPTERS;
---

<section
  class="g-static-story"
  aria-label="Leistungen von der Planung bis zum Service"
>
  {
    chapters.map((chapter) => (
      <section class="g-static-chapter" id={`g-${chapter.id}`}>
        <div class="g-static-visual">
          <img
            src={versionGStoryAssetUrl(baseUrl, chapter.asset)}
            width={chapter.asset.width}
            height={chapter.asset.height}
            alt={chapter.asset.alt}
            loading={chapter.id === 'planning' ? 'eager' : 'lazy'}
            decoding="async"
          />
        </div>
        <article class="g-story-copy is-active">
          <p class="g-eyebrow">
            <strong>{chapter.number}</strong> · {chapter.label}
          </p>
          <h2>
            {chapter.title.map((line) => (
              <span class="g-story-title-line">{line}</span>
            ))}
          </h2>
          <p class="g-story-description">{chapter.description}</p>
          <a class="g-outline-button" href={`${baseUrl}${chapter.href}`}>
            <span>{chapter.cta}</span>
            <span aria-hidden="true">→</span>
          </a>
        </article>
      </section>
    ))
  }
</section>
