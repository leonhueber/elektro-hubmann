---
import { company } from '../../../config/site';

interface Props {
  baseUrl: string;
}

const { baseUrl } = Astro.props;
const root = baseUrl.replace(/\/$/, '');
const nav = [
  ['Leistungen', `${root}/#leistungen`],
  ['Projekte', `${root}/#projekte`],
  ['Unternehmen', `${root}/#unternehmen`],
  ['Kontakt', `${root}/#kontakt`],
] as const;
---

<div class="g-header-shell">
  <div class="g-info-bar">
    <div>
      <a href={company.emergencyHref}
        >Störungsdienst: <strong>{company.emergency}</strong></a
      >
      <span class="g-shop-hours">{company.shopHours}</span>
      <a class="g-shop-hours-link" href={`${root}/#fachhandel`}>
        Fachgeschäft &amp; Öffnungszeiten →
      </a>
    </div>
  </div>
  <header class="g-header">
    <a
      class="g-logo"
      href={`${root}/`}
      aria-label="Elektro Hubmann – Startseite"
    >
      <img
        src={`${baseUrl}logo-elektrotechnik-hubmann.png`}
        width="287"
        height="78"
        alt="Elektrotechnik Hubmann"
      />
    </a>
    <nav class="g-main-nav" aria-label="Hauptnavigation">
      {nav.map(([label, href]) => <a href={href}>{label}</a>)}
    </nav>
    <a class="g-header-cta" href={`${root}/#kontakt`}
      >Kontakt aufnehmen <span aria-hidden="true">→</span></a
    >
    <details class="g-mobile-menu">
      <summary>
        <span class="g-menu-icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
        <span class="sr-only">Hauptmenü</span>
      </summary>
      <nav aria-label="Mobile Navigation">
        {nav.map(([label, href]) => <a href={href}>{label}</a>)}
        <a href={company.emergencyHref}>Störungsdienst: {company.emergency}</a>
        <a href={`${root}/#fachhandel`}>Fachgeschäft</a>
        <a href={`${root}/#kontakt`}>Kontakt aufnehmen →</a>
      </nav>
    </details>
  </header>
</div>

<script>
  document
    .querySelectorAll<HTMLDetailsElement>('.g-mobile-menu')
    .forEach((menu) => {
      menu.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => menu.removeAttribute('open'));
      });
    });
</script>
