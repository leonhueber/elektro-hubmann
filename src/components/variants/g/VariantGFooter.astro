---
import { company } from '../../../config/site';
interface Props {
  baseUrl: string;
}
const { baseUrl } = Astro.props;
const root = baseUrl.replace(/\/$/, '');
const currentYear = new Date().getFullYear();
const mapsUrl =
  'https://www.google.com/maps/dir/?api=1&destination=Weißbriach+94%2C+9622+Weißbriach';
---

<footer class="g-footer" id="kontakt">
  <div class="g-footer-grid">
    <div>
      <a href={`${root}/`} aria-label="Elektro Hubmann – Startseite">
        <img
          src={`${baseUrl}logo-elektrotechnik-hubmann.png`}
          width="287"
          height="78"
          alt="Elektrotechnik Hubmann"
        />
      </a>
    </div>
    <div>
      <strong>Kontakt</strong>
      <a class="g-footer-phone" href={company.phoneHref}>
        Telefon: <span>{company.phone}</span>
      </a>
      <a class="g-footer-phone" href={company.emergencyHref}>
        Störungsdienst: <span>{company.emergency}</span>
      </a>
      <a href={company.emailHref}>{company.email}</a>
      <a href={mapsUrl} target="_blank" rel="noreferrer">
        {company.address} ↗
      </a>
    </div>
    <div>
      <strong>Seiten</strong>
      <a href={`${root}/`}>Startseite</a>
      <a href={`${root}/#leistungen`}>Leistungen</a>
      <a href={`${root}/#projekte`}>Projekte</a>
      <a href={`${root}/#unternehmen`}>Unternehmen</a>
      <a href={`${root}/#fachhandel`}>Fachgeschäft &amp; Öffnungszeiten</a>
    </div>
    <div>
      <strong>Rechtliches</strong>
      <a href={`${root}/impressum/`}>Impressum</a>
      <a href={`${root}/datenschutz/`}>Datenschutz</a>
      <a href={`${root}/agb/`}>AGB</a>
      <a href={`${root}/barrierefreiheit/`}>Barrierefreiheit</a>
      <a href={`${root}/bild-lizenznachweise/`}>
        Bild- &amp; Lizenznachweise
      </a>
    </div>
  </div>
  <p class="g-footer-note">
    © {currentYear} Elektro Hubmann. Alle Rechte vorbehalten.
  </p>
</footer>
