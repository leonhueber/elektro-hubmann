---
import HomeSections from '../HomeSections.astro';
import SiteFooter from '../SiteFooter.astro';
import SiteHeader from '../SiteHeader.astro';
import { withBase } from '../../lib/url';

const pagePath = Astro.url.pathname;
---

<SiteHeader pagePath={pagePath} />

<main id="hauptinhalt">
  <section class="hero hero--c">
    <div class="hero__backdrop">
      <img
        src={withBase('/images/legacy-placeholders/hubmann-slider-4.jpg')}
        alt=""
        width="1920"
        height="1277"
      />
    </div>
    <div class="hero__copy">
      <span class="eyebrow">Aus der Region · Für die Region</span>
      <h1>Elektroinstallationen für Neubau, Sanierung und Gewerbe.</h1>
      <p>
        Von der Planung bis zur fachgerechten Ausführung – in Gitschtal,
        Hermagor und am Weißensee.
      </p>
      <div class="button-row">
        <a class="button" href="#projektanfrage">Projekt anfragen</a>
        <a class="button button--light" href="#leistungen">Leistungen ansehen</a
        >
      </div>
    </div>
  </section>

  <HomeSections />
</main>

<SiteFooter />
