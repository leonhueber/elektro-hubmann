---
import HomeSections from '../HomeSections.astro';
import SiteFooter from '../SiteFooter.astro';
import SiteHeader from '../SiteHeader.astro';
import { withBase } from '../../lib/url';

const pagePath = Astro.url.pathname;
---

<SiteHeader pagePath={pagePath} />

<main id="hauptinhalt">
  <section class="hero hero--a">
    <div class="hero__copy">
      <span class="eyebrow">Elektro Hubmann · Weißbriach</span>
      <h1>Elektroinstallationen für Neubau, Sanierung und Gewerbe.</h1>
      <p>
        Von der Planung bis zur fachgerechten Ausführung – in Gitschtal,
        Hermagor und am Weißensee.
      </p>
      <div class="button-row">
        <a class="button" href="#projektanfrage">Projekt anfragen</a>
        <a class="button button--secondary" href="#leistungen"
          >Leistungen ansehen</a
        >
      </div>
    </div>
    <div class="hero__media">
      <img
        src={withBase('/images/legacy-placeholders/hubmann-slider-4.jpg')}
        alt="Elektrotechniker bei der Arbeit an einem Verteiler"
        width="1920"
        height="1277"
      />
      <span>Planung · Ausführung · Service</span>
    </div>
  </section>

  <HomeSections />
</main>

<SiteFooter />
