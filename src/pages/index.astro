---
import BaseLayout from '../layouts/BaseLayout.astro';
import VariantG from '../components/variants/VariantG.astro';
import { createSiteSchema } from '../lib/structured-data';
import {
  VERSION_G_STORY_ASSETS,
  versionGStoryAssetUrl,
} from '../config/version-g-story-assets';
import { withBase } from '../lib/url';

const canonicalPath = withBase('/');
const homeUrl = new URL(canonicalPath, Astro.site ?? Astro.url.origin).href;
const title =
  'Elektroinstallationen in Gitschtal, Hermagor und am Weißensee – Elektro Hubmann';
const description =
  'Elektro Hubmann plant und realisiert Elektroinstallationen, Gebäudetechnik und Photovoltaik für Neubau, Sanierung und Gewerbe.';
const storyHeroImage = versionGStoryAssetUrl(
  import.meta.env.BASE_URL,
  VERSION_G_STORY_ASSETS.planning,
);
const schema = createSiteSchema({
  homeUrl,
  pageUrl: homeUrl,
  title,
  description,
});
---

<BaseLayout
  title={title}
  description={description}
  bodyClass="variant variant-g"
  canonicalPath={canonicalPath}
  ogImage={storyHeroImage}
  preloadImage={storyHeroImage}
  schema={schema}
>
  <VariantG />
</BaseLayout>
