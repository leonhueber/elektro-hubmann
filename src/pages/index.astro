---
import BaseLayout from '../layouts/BaseLayout.astro';
import VariantG from '../components/variants/VariantG.astro';
import { company } from '../config/site';
import { withBase } from '../lib/url';

const canonicalPath = withBase('/');
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Electrician',
  name: company.name,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Weißbriach 94',
    postalCode: '9622',
    addressLocality: 'Weißbriach',
    addressCountry: 'AT',
  },
  telephone: '+43 4286 240',
  email: company.email,
  url: new URL(canonicalPath, Astro.site ?? Astro.url.origin).href,
};
---

<BaseLayout
  title="Elektroinstallationen in Gitschtal, Hermagor und am Weißensee – Elektro Hubmann"
  description="Elektro Hubmann plant und realisiert Elektroinstallationen, Gebäudetechnik und Photovoltaik für Neubau, Sanierung und Gewerbe."
  bodyClass="variant variant-g"
  canonicalPath={canonicalPath}
  ogImage={withBase('/images/version-g/sequence/house-0120.jpg')}
  preloadImage={withBase('/images/version-g/sequence/house-0001.jpg')}
  schema={schema}
>
  <VariantG />
</BaseLayout>
