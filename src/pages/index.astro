---
import BaseLayout from '../layouts/BaseLayout.astro';
import { variants } from '../config/site';
import { variantPath, withBase } from '../lib/url';
---

<BaseLayout
  title="Elektro Hubmann – Designvorschau"
  description="Sieben Designrichtungen für den Neubau der Elektro-Hubmann-Website."
  bodyClass="preview-index"
>
  <header class="preview-header">
    <img
      src={withBase('/logo-elektrotechnik-hubmann.png')}
      width="287"
      height="78"
      alt="Elektrotechnik Hubmann"
    />
    <span>Website-Neubau · Arbeitsstand</span>
  </header>

  <main id="hauptinhalt" class="preview-main">
    <span class="eyebrow">Sieben Richtungen · ein gemeinsamer Inhalt</span>
    <h1>Welche Gestaltung passt zu Elektro Hubmann?</h1>
    <p class="preview-intro">
      Alle Versionen sind live, direkt vergleichbar und bewusst noch nicht für
      Suchmaschinen freigegeben.
    </p>

    <div class="variant-cards">
      {
        variants.map((variant) => (
          <a
            class={`variant-card variant-card--${variant.id}`}
            href={variantPath(variant.id)}
          >
            <span>{variant.name}</span>
            <strong>{variant.direction}</strong>
            <p>{variant.summary}</p>
            <em>Version öffnen →</em>
          </a>
        ))
      }
    </div>
  </main>
</BaseLayout>
