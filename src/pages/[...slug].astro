---
import '@fontsource-variable/inter/index.css';
import '@fontsource-variable/inter-tight/index.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import VariantGHeader from '../components/variants/g/VariantGHeader.astro';
import VariantGFooter from '../components/variants/g/VariantGFooter.astro';
import { company } from '../config/site';
import { withBase } from '../lib/url';
import '../styles/variant-g.css';

const legalPages = {
  impressum: {
    title: 'Impressum',
    description: 'Impressum und Anbieterinformationen von Elektro Hubmann.',
  },
  datenschutz: {
    title: 'Datenschutz',
    description: 'Informationen zum Datenschutz bei Elektro Hubmann.',
  },
  agb: {
    title: 'Allgemeine Geschäftsbedingungen',
    description: 'Hinweise zu den Vertragsbedingungen von Elektro Hubmann.',
  },
  barrierefreiheit: {
    title: 'Barrierefreiheit',
    description:
      'Hinweise zur Barrierefreiheit der Website von Elektro Hubmann.',
  },
  'bild-lizenznachweise': {
    title: 'Bild- und Lizenznachweise',
    description: 'Bild- und Lizenznachweise der Website von Elektro Hubmann.',
  },
} as const;

type LegalSlug = keyof typeof legalPages;

export function getStaticPaths() {
  return [
    'impressum',
    'datenschutz',
    'agb',
    'barrierefreiheit',
    'bild-lizenznachweise',
  ].map((slug) => ({ params: { slug }, props: { slug } }));
}

interface Props {
  slug: LegalSlug;
}

const { slug } = Astro.props as Props;
const page = legalPages[slug];
const baseUrl = import.meta.env.BASE_URL;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Electrician',
  name: company.name,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Weißbriach 94',
    postalCode: '9622',
    addressLocality: 'Weißbriach',
    addressCountry: 'AT',
  },
  telephone: '+43 4286 240',
  email: company.email,
  url: 'https://elektro-hubmann.at/',
};
---

<BaseLayout
  title={`${page.title} – Elektro Hubmann`}
  description={page.description}
  bodyClass="variant variant-g"
  canonicalPath={withBase(`/${slug}/`)}
  schema={schema}
>
  <VariantGHeader baseUrl={baseUrl} />
  <main id="hauptinhalt" class="g-page">
    {
      slug === 'impressum' && (
        <>
          <header class="g-page-hero">
            <p class="g-eyebrow">
              <strong>Rechtliches</strong> · Entwurf
            </p>
            <h1>Impressum</h1>
            <p>Arbeitsstand – vor Veröffentlichung rechtlich prüfen.</p>
          </header>
          <div class="g-prose">
            <h2>Medieninhaber</h2>
            <p>
              {company.name}
              <br />
              Inhaber: {company.proprietor}
              <br />
              {company.address}
              <br />
              Telefon: <a href={company.phoneHref}>{company.phone}</a>
              <br />
              E-Mail: <a href={company.emailHref}>{company.email}</a>
            </p>
            <h2>Noch zu ergänzen</h2>
            <p>
              Rechtsform, Firmenbuch- oder Gewerbedaten, zuständige
              Aufsichtsbehörde, Kammerzugehörigkeit und weitere gesetzlich
              erforderliche Angaben müssen verifiziert werden.
            </p>
          </div>
        </>
      )
    }

    {
      slug === 'datenschutz' && (
        <>
          <header class="g-page-hero">
            <p class="g-eyebrow">
              <strong>Rechtliches</strong> · Entwurf
            </p>
            <h1>Datenschutz</h1>
            <p>
              Struktureller Entwurf – vor Veröffentlichung an Hosting und
              eingesetzte Dienste anpassen.
            </p>
          </header>
          <div class="g-prose">
            <h2>Verantwortlicher</h2>
            <p>
              {company.name}, {company.address}, {company.email}
            </p>
            <h2>Website-Aufruf</h2>
            <p>
              Beim Aufruf einer Website können technisch notwendige
              Server-Logdaten verarbeitet werden. Umfang, Speicherdauer und
              Empfänger hängen vom final gewählten Hostinganbieter ab und werden
              vor Veröffentlichung ergänzt.
            </p>
            <h2>Kontaktaufnahme</h2>
            <p>
              Diese Website verwendet kein Kontaktformular. Die Kontaktaufnahme
              erfolgt direkt per Telefon oder E-Mail. Die dafür erforderlichen
              Datenschutzinformationen werden vor Veröffentlichung rechtlich
              geprüft und vervollständigt.
            </p>
            <h2>Cookies und externe Inhalte</h2>
            <p>
              Die aktuelle Website setzt keine Marketing-Cookies und bindet
              keine Google-Karte ein. Die Routenplanung wird nur über einen
              externen Link geöffnet.
            </p>
          </div>
        </>
      )
    }

    {
      slug === 'agb' && (
        <>
          <header class="g-page-hero">
            <p class="g-eyebrow">
              <strong>Rechtliches</strong> · Vertragsbedingungen
            </p>
            <h1>Allgemeine Geschäftsbedingungen</h1>
            <p>
              Für diese Website sind derzeit keine verbindlichen Allgemeinen
              Geschäftsbedingungen hinterlegt.
            </p>
          </header>
          <div class="g-prose">
            <h2>Aktueller Stand</h2>
            <p>
              Über diese Website werden aktuell weder ein Online-Shop noch ein
              verbindlicher Bestell- oder Vertragsabschluss angeboten. Deshalb
              veröffentlichen wir hier bewusst keine ungeprüften Muster-AGB.
            </p>
            <h2>Vertragsgrundlage</h2>
            <p>
              Maßgeblich sind ausschließlich die im jeweiligen Angebot oder
              Vertrag ausdrücklich vereinbarten beziehungsweise wirksam
              einbezogenen Bedingungen.
            </p>
            <h2>Künftige AGB</h2>
            <p>
              Falls Elektro Hubmann künftig AGB verwendet, wird hier nur die
              tatsächlich freigegebene Fassung veröffentlicht. Sie muss zur
              Rechtsform, zum Leistungsangebot und zum konkreten
              Vertragsabschluss passen und speicherbar abrufbar sein.
            </p>
          </div>
        </>
      )
    }

    {
      slug === 'barrierefreiheit' && (
        <>
          <header class="g-page-hero">
            <p class="g-eyebrow">
              <strong>Barrierefreiheit</strong> · Arbeitsstand
            </p>
            <h1>Hinweis zur Barrierefreiheit</h1>
            <p>
              Uns ist wichtig, dass diese Website für möglichst viele Menschen
              gut zugänglich ist.
            </p>
          </header>
          <div class="g-prose">
            <h2>Geltungsbereich</h2>
            <p>
              Dieser Hinweis bezieht sich auf die Website von Elektro Hubmann
              unter elektro-hubmann.at. Bei ihrer Gestaltung und
              Weiterentwicklung orientieren wir uns an den Web Content
              Accessibility Guidelines (WCAG) 2.2, Konformitätsstufe AA.
            </p>
            <h2>Bereits berücksichtigte Maßnahmen</h2>
            <ul>
              <li>
                semantische Seitenstruktur und nachvollziehbare Überschriften
              </li>
              <li>Skip-Link und sichtbare Tastaturfokusse</li>
              <li>
                per Tastatur bedienbare Navigation und ausreichend große Ziele
              </li>
              <li>aussagekräftige Alternativtexte für Inhaltsbilder</li>
              <li>
                reduzierte beziehungsweise statische Darstellung bei aktivierter
                Einstellung „Bewegung reduzieren“
              </li>
              <li>
                responsive Darstellung ohne notwendiges horizontales Scrollen
              </li>
            </ul>
            <h2>Prüfstatus</h2>
            <p>
              Eine vollständige manuelle und technische Prüfung aller Seiten und
              Funktionen ist noch nicht abgeschlossen. Deshalb geben wir derzeit
              keine Erklärung über eine vollständige oder teilweise Konformität
              mit WCAG 2.2 AA ab. Es können noch Barrieren bestehen.
            </p>
            <h2>Feedback und Kontakt</h2>
            <p>
              Wenn Ihnen eine Barriere auffällt, kontaktieren Sie uns bitte
              unter <a href={company.emailHref}>{company.email}</a> oder
              telefonisch unter <a href={company.phoneHref}>{company.phone}</a>.
              Beschreiben Sie nach Möglichkeit die betroffene Seite und das
              aufgetretene Problem. Wir bemühen uns um eine besser zugängliche
              Alternative.
            </p>
            <h2>Stand</h2>
            <p>
              31. August 2026. Der Hinweis wird nach Abschluss der Prüfung und
              vor der Veröffentlichung aktualisiert.
            </p>
          </div>
        </>
      )
    }

    {
      slug === 'bild-lizenznachweise' && (
        <>
          <header class="g-page-hero">
            <p class="g-eyebrow">
              <strong>Nachweise</strong> · Arbeitsstand
            </p>
            <h1>Bild- und Lizenznachweise</h1>
            <p>
              Dieses Verzeichnis dokumentiert die im Websiteentwurf verwendeten
              Medien und bekannte Lizenzgrundlagen.
            </p>
          </header>
          <div class="g-prose">
            <h2>Konzeptvisualisierungen</h2>
            <p>
              Die Architektur- und Technikvisualisierungen wurden im Rahmen des
              Websiteentwurfs mithilfe von OpenAI ImageGen erstellt. Sie zeigen
              keine realen Referenzprojekte, keine zugesicherten
              Ausführungsdetails und keine verbindlich dargestellten Produkte
              oder Hersteller.
            </p>
            <h2>Fotografien und Bestandsbilder</h2>
            <p>
              Einzelne Fotografien werden derzeit als Arbeits- und
              Platzhalterbilder aus dem bisherigen Webauftritt verwendet.
              Urheberschaft, abgebildete Personen und der konkrete
              Nutzungsumfang werden vor der endgültigen Veröffentlichung geprüft
              und dokumentiert.
            </p>
            <h2>Logo und Marken</h2>
            <p>
              Das Logo und die Bezeichnung „Elektro Hubmann“ werden für den
              Unternehmensauftritt verwendet. Etwaige Marken-, Kennzeichen- und
              Urheberrechte verbleiben bei den jeweiligen Rechteinhabern.
              Abgebildete Produktformen oder Gestaltungsmerkmale begründen keine
              Verbindung zu einem bestimmten Hersteller.
            </p>
            <h2>Schriften</h2>
            <p>
              Verwendet werden „Inter“ und „Inter Tight“, lokal eingebunden über
              <a href="https://fontsource.org/" rel="external">
                Fontsource
              </a>
              . Beide Schriftfamilien stehen unter der{' '}
              <a href="https://openfontlicense.org/" rel="external">
                SIL Open Font License 1.1
              </a>
              .
            </p>
            <h2>3D-Materialien</h2>
            <p>
              Ergänzende projektintern erzeugte 3D-Visualisierungen verwenden
              die Texturen{' '}
              <a
                href="https://polyhaven.com/a/concrete_wall_009"
                rel="external"
              >
                Concrete Wall 009
              </a>
              ,{' '}
              <a href="https://polyhaven.com/a/oak_veneer_01" rel="external">
                Oak Veneer 01
              </a>{' '}
              und{' '}
              <a href="https://polyhaven.com/a/grey_roof_01" rel="external">
                Grey Roof 01
              </a>{' '}
              von Poly Haven. Diese Materialien stehen unter{' '}
              <a href="https://polyhaven.com/license" rel="external">
                CC0
              </a>
              .
            </p>
            <h2>Hinweise zu Bildrechten</h2>
            <p>
              Hinweise zu Bild- oder Nutzungsrechten richten Sie bitte an{' '}
              <a href={company.emailHref}>{company.email}</a>.
            </p>
            <p>Stand: 31. August 2026.</p>
          </div>
        </>
      )
    }
  </main>
  <VariantGFooter baseUrl={baseUrl} />
</BaseLayout>
