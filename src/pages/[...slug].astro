---
import '@fontsource-variable/inter/index.css';
import '@fontsource-variable/inter-tight/index.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import VariantGHeader from '../components/variants/g/VariantGHeader.astro';
import VariantGFooter from '../components/variants/g/VariantGFooter.astro';
import { company, projects, services } from '../config/site';
import '../styles/variant-g.css';

export function getStaticPaths() {
  const servicePages = services.map((item) => `leistungen/${item.slug}`);
  const projectPages = Array.from(
    { length: 6 },
    (_, index) => `projekte/projekt-${index + 1}`,
  );
  const pages = [
    'leistungen',
    ...servicePages,
    'projekte',
    ...projectPages,
    'unternehmen',
    'kontakt',
    'fachhandel',
    'impressum',
    'datenschutz',
    'agb',
    'barrierefreiheit',
    'bild-lizenznachweise',
  ];
  return pages.map((slug) => ({ params: { slug }, props: { slug } }));
}

interface Props {
  slug: string;
}
const { slug } = Astro.props as Props;
const [section, detail] = slug.split('/');
const serviceIndex = detail
  ? services.findIndex((item) => item.slug === detail)
  : -1;
const service = serviceIndex >= 0 ? services[serviceIndex] : undefined;
const projectIndex = detail?.startsWith('projekt-')
  ? Number(detail.replace('projekt-', '')) - 1
  : -1;
const project = projectIndex >= 0 ? projects[projectIndex] : undefined;
const baseUrl = import.meta.env.BASE_URL;
const root = baseUrl.replace(/\/$/, '');

const titles: Record<string, string> = {
  leistungen: 'Leistungen',
  projekte: 'Projekte',
  unternehmen: 'Unternehmen',
  kontakt: 'Kontakt',
  fachhandel: 'Fachhandel',
  impressum: 'Impressum',
  datenschutz: 'Datenschutz',
  agb: 'Allgemeine Geschäftsbedingungen',
  barrierefreiheit: 'Barrierefreiheit',
  'bild-lizenznachweise': 'Bild- und Lizenznachweise',
};
const title =
  service?.title ?? project?.type ?? titles[section ?? ''] ?? 'Elektro Hubmann';
const description = service?.description ?? `Elektro Hubmann – ${title}`;
const active = ['leistungen', 'projekte', 'unternehmen', 'kontakt'].includes(
  section ?? '',
)
  ? section
  : '';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Electrician',
  name: company.name,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Weißbriach 94',
    postalCode: '9622',
    addressLocality: 'Weißbriach',
    addressCountry: 'AT',
  },
  telephone: '+43 4286 240',
  email: company.email,
  url: 'https://elektro-hubmann.at/',
};
---

<BaseLayout
  title={`${title} – Elektro Hubmann`}
  description={description}
  bodyClass="variant variant-g"
  canonicalPath={`${root}/${slug}/`}
  schema={schema}
>
  <VariantGHeader baseUrl={baseUrl} active={active} />
  <main id="hauptinhalt" class="g-page">
    {
      section === 'leistungen' && !service && (
        <>
          <header class="g-page-hero">
            <p class="g-eyebrow">
              <strong>01</strong> · Leistungen
            </p>
            <h1>Elektrotechnik als durchdachtes Gesamtsystem.</h1>
            <p>
              Von der ersten Planung bis zur Prüfung und Übergabe: fünf
              Bereiche, die auf der Baustelle ineinandergreifen.
            </p>
          </header>
          <div class="g-service-list">
            {services.map((item) => (
              <a
                class="g-service-entry"
                href={`${root}/leistungen/${item.slug}/`}
              >
                <span>{item.marker}</span>
                <h2>{item.title}</h2>
                <p>{item.description}</p>
                <strong>Öffnen →</strong>
              </a>
            ))}
          </div>
        </>
      )
    }

    {
      service && (
        <>
          <header class="g-page-hero">
            <p class="g-eyebrow">
              <strong>{service.marker}</strong> · Leistung
            </p>
            <h1>{service.title}</h1>
            <p>{service.description}</p>
          </header>
          <div class="g-prose">
            <h2>Was wir dabei übernehmen</h2>
            <p>{service.details}</p>
            <p>
              Der konkrete Leistungsumfang wird im persönlichen Gespräch und
              nach Besichtigung des Projekts festgelegt.
            </p>
            <a
              class="g-outline-button"
              href={`${root}/kontakt/#projektanfrage`}
            >
              Projekt besprechen →
            </a>
          </div>
        </>
      )
    }

    {
      section === 'projekte' && !project && (
        <>
          <header class="g-page-hero">
            <p class="g-eyebrow">
              <strong>02</strong> · Projekte
            </p>
            <h1>Arbeit, die man sehen kann.</h1>
            <p>
              Die Bilder dienen derzeit als Platzhalter. Verifizierte
              Projektorte, Leistungen und Fertigstellungsjahre werden vor
              Veröffentlichung ergänzt.
            </p>
          </header>
          <div class="g-project-overview g-project-list">
            {projects.map((item, index) => (
              <a
                class="g-project-row"
                href={`${root}/projekte/projekt-${index + 1}/`}
              >
                <div class="g-project-image">
                  <img
                    src={`${baseUrl}${item.image.replace(/^\//, '')}`}
                    width={item.width}
                    height={item.height}
                    alt={item.alt}
                    loading="lazy"
                  />
                </div>
                <div>
                  <span>0{index + 1}</span>
                  <h2>{item.type}</h2>
                  <p>Projektdaten werden ergänzt.</p>
                  <strong>Details ansehen →</strong>
                </div>
              </a>
            ))}
          </div>
        </>
      )
    }

    {
      project && (
        <>
          <header class="g-page-hero">
            <p class="g-eyebrow">
              <strong>Projekt</strong> · Projektbeispiel
            </p>
            <h1>{project.type}</h1>
            <p>
              Diese Detailseite zeigt die vorgesehene Darstellung. Verifizierte
              Projektinformationen liegen noch nicht vor.
            </p>
          </header>
          <div class="g-project-image" style="height:min(62vw,680px)">
            <img
              src={`${baseUrl}${project.image.replace(/^\//, '')}`}
              width={project.width}
              height={project.height}
              alt={project.alt}
            />
          </div>
          <div class="g-prose">
            <h2>Projektangaben</h2>
            <p>
              <strong>Region:</strong> wird ergänzt
              <>
                <br />
                <strong>Ausgeführte Leistungen:</strong>
              </>{' '}
              werden ergänzt
              <>
                <br />
                <strong>Fertigstellungsjahr:</strong>
              </>{' '}
              wird ergänzt
            </p>
          </div>
        </>
      )
    }

    {
      section === 'unternehmen' && (
        <>
          <header class="g-page-hero">
            <>
              <p class="g-eyebrow">
                <strong>03</strong> · Unternehmen
              </p>
              <h1>Seit 1972 persönlich vor Ort.</h1>
              <p>
                Elektro Hubmann ist ein Familienbetrieb aus Weißbriach mit über
                50 Jahren Erfahrung.
              </p>
            </>
          </header>
          <div class="g-facts">
            <>
              <div>
                <>
                  <strong>1972</strong>
                  <span>Gründungsjahr</span>
                </>
              </div>
              <div>
                <>
                  <strong>50+</strong>
                  <span>Jahre Erfahrung</span>
                </>
              </div>
              <div>
                <>
                  <strong>Weißbriach</strong>
                  <span>Regionaler Standort</span>
                </>
              </div>
            </>
          </div>
          <div class="g-prose">
            <>
              <h2>Persönlich und regional</h2>
              <p>
                Kurze Wege, direkte Kommunikation und die Verantwortung für
                Planung und Ausführung aus einer Hand stehen im Mittelpunkt.
              </p>
              <p>
                Weitere Team-, Geschichts- und Qualifikationsangaben werden erst
                nach inhaltlicher Freigabe ergänzt.
              </p>
            </>
          </div>
        </>
      )
    }

    {
      section === 'kontakt' && (
        <>
          <header class="g-page-hero">
            <>
              <p class="g-eyebrow">
                <strong>04</strong> · Kontakt
              </p>
              <h1>Ihr Projekt beginnt mit einem Gespräch.</h1>
              <p>
                Rufen Sie uns an, schreiben Sie eine E-Mail oder bereiten Sie
                Ihre Anfrage mit dem Formular vor.
              </p>
            </>
          </header>
          <div class="g-contact-links">
            <>
              <a href={company.phoneHref}>{company.phone}</a>
              <a href={company.emailHref}>{company.email}</a>
              <a
                href="https://www.google.com/maps/dir/?api=1&destination=Weißbriach+94%2C+9622+Weißbriach"
                target="_blank"
                rel="noreferrer"
              >
                Route planen ↗
              </a>
            </>
          </div>
          <form class="g-form" id="projektanfrage">
            <label>
              Name *<input name="name" autocomplete="name" required />
            </label>
            <label>
              Telefonnummer *
              <input name="phone" type="tel" autocomplete="tel" required />
            </label>
            <label>
              E-Mail *
              <input name="email" type="email" autocomplete="email" required />
            </label>
            <label>
              Baustellenort *
              <input name="location" autocomplete="street-address" required />
            </label>
            <label>
              Projektart *
              <select name="projectType" required>
                <>
                  <option value="">Bitte wählen</option>
                  <option>Neubau</option>
                  <option>Sanierung</option>
                  <option>Gewerbe</option>
                </>
              </select>
            </label>
            <label>
              Gewünschter Zeitraum
              <input name="timeframe" />
            </label>
            <label class="wide">
              Beschreibung *<textarea name="description" required />
            </label>
            <label class="wide">
              Plan oder Foto (optional)
              <>
                <input
                  name="attachment"
                  type="file"
                  accept="image/jpeg,image/png,image/webp,application/pdf"
                  aria-describedby="file-note"
                />
                <small id="file-note">
                  JPEG, PNG, WebP oder PDF; maximal 10 MB.
                </small>
              </>
            </label>
            <p class="g-form-note" id="form-status" role="status" tabindex="-1">
              Der Online-Versand ist derzeit noch nicht aktiviert. Nach der
              Prüfung können Sie Ihre Anfrage per Telefon oder E-Mail
              übermitteln.
            </p>
            <button class="g-solid-button" id="form-check" type="button">
              Anfrage prüfen →
            </button>
          </form>
        </>
      )
    }

    {
      section === 'fachhandel' && (
        <>
          <>
            <header class="g-page-hero">
              <>
                <p class="g-eyebrow">
                  <strong>Fachhandel</strong> · Weißbriach
                </p>
                <h1>Persönliche Beratung im Fachgeschäft.</h1>
                <p>Der Fachhandel bleibt als ergänzender Bereich erreichbar.</p>
              </>
            </header>
            <div class="g-prose">
              <>
                <h2>Kontakt und Standort</h2>
                <p>
                  {company.address}
                  <br />
                  <>
                    <a href={company.phoneHref}>{company.phone}</a>
                    <br />
                    <a href={company.emailHref}>{company.email}</a>
                  </>
                </p>
                <h2>Öffnungszeiten</h2>
                <p>{company.shopHours}</p>
                <p>
                  Bitte die Öffnungszeiten vor der produktiven Veröffentlichung
                  noch einmal bestätigen.
                </p>
              </>
            </div>
          </>
        </>
      )
    }

    {
      section === 'impressum' && (
        <>
          <>
            <header class="g-page-hero">
              <>
                <p class="g-eyebrow">
                  <strong>Rechtliches</strong> · Entwurf
                </p>
                <h1>Impressum</h1>
                <p>Arbeitsstand – vor Veröffentlichung rechtlich prüfen.</p>
              </>
            </header>
            <div class="g-prose">
              <>
                <h2>Medieninhaber</h2>
                <p>
                  {company.name}
                  <br />
                  Inhaber: {company.proprietor}
                  <br />
                  {company.address}
                  <br />
                  Telefon: {company.phone}
                  <br />
                  E-Mail: {company.email}
                </p>
                <h2>Noch zu ergänzen</h2>
                <p>
                  Rechtsform, Firmenbuch- oder Gewerbedaten, zuständige
                  Aufsichtsbehörde, Kammerzugehörigkeit und weitere gesetzlich
                  erforderliche Angaben müssen verifiziert werden.
                </p>
              </>
            </div>
          </>
        </>
      )
    }

    {
      section === 'datenschutz' && (
        <>
          <>
            <header class="g-page-hero">
              <>
                <p class="g-eyebrow">
                  <strong>Rechtliches</strong> · Entwurf
                </p>
                <h1>Datenschutz</h1>
                <p>
                  Struktureller Entwurf – vor Veröffentlichung an Hosting,
                  Formular und eingesetzte Dienste anpassen.
                </p>
              </>
            </header>
            <div class="g-prose">
              <>
                <h2>Verantwortlicher</h2>
                <p>
                  {company.name}, {company.address}, {company.email}
                </p>
                <h2>Website-Aufruf</h2>
                <p>
                  Beim Aufruf einer Website können technisch notwendige
                  Server-Logdaten verarbeitet werden. Umfang, Speicherdauer und
                  Empfänger hängen vom final gewählten Hostinganbieter ab und
                  werden vor Veröffentlichung ergänzt.
                </p>
                <h2>Kontaktaufnahme</h2>
                <p>
                  Das Formular versendet derzeit keine Daten. Die spätere
                  Verarbeitung von Anfragen muss nach Auswahl des
                  Formularservices vollständig dokumentiert werden.
                </p>
                <h2>Cookies und externe Inhalte</h2>
                <p>
                  Die aktuelle Website setzt keine Marketing-Cookies und bindet
                  keine Google-Karte ein. Die Routenplanung wird nur über einen
                  externen Link geöffnet.
                </p>
              </>
            </div>
          </>
        </>
      )
    }

    {
      section === 'agb' && (
        <>
          <header class="g-page-hero">
            <p class="g-eyebrow">
              <strong>Rechtliches</strong> · Vertragsbedingungen
            </p>
            <h1>Allgemeine Geschäftsbedingungen</h1>
            <p>
              Für diese Website sind derzeit keine verbindlichen Allgemeinen
              Geschäftsbedingungen hinterlegt.
            </p>
          </header>
          <div class="g-prose">
            <h2>Aktueller Stand</h2>
            <p>
              Über diese Website werden aktuell weder ein Online-Shop noch ein
              verbindlicher Bestell- oder Vertragsabschluss angeboten. Deshalb
              veröffentlichen wir hier bewusst keine ungeprüften Muster-AGB.
            </p>
            <h2>Vertragsgrundlage</h2>
            <p>
              Maßgeblich sind ausschließlich die im jeweiligen Angebot oder
              Vertrag ausdrücklich vereinbarten beziehungsweise wirksam
              einbezogenen Bedingungen.
            </p>
            <h2>Künftige AGB</h2>
            <p>
              Falls Elektro Hubmann künftig AGB verwendet, wird hier nur die
              tatsächlich freigegebene Fassung veröffentlicht. Sie muss zur
              Rechtsform, zum Leistungsangebot und zum konkreten
              Vertragsabschluss passen und speicherbar abrufbar sein.
            </p>
          </div>
        </>
      )
    }

    {
      section === 'barrierefreiheit' && (
        <>
          <header class="g-page-hero">
            <p class="g-eyebrow">
              <strong>Barrierefreiheit</strong> · Arbeitsstand
            </p>
            <h1>Hinweis zur Barrierefreiheit</h1>
            <p>
              Uns ist wichtig, dass diese Website für möglichst viele Menschen
              gut zugänglich ist.
            </p>
          </header>
          <div class="g-prose">
            <h2>Geltungsbereich</h2>
            <p>
              Dieser Hinweis bezieht sich auf die Website von Elektro Hubmann
              unter elektro-hubmann.at. Bei ihrer Gestaltung und
              Weiterentwicklung orientieren wir uns an den Web Content
              Accessibility Guidelines (WCAG) 2.2, Konformitätsstufe AA.
            </p>
            <h2>Bereits berücksichtigte Maßnahmen</h2>
            <ul>
              <li>
                semantische Seitenstruktur und nachvollziehbare Überschriften
              </li>
              <li>Skip-Link und sichtbare Tastaturfokusse</li>
              <li>
                per Tastatur bedienbare Navigation und ausreichend große Ziele
              </li>
              <li>aussagekräftige Alternativtexte für Inhaltsbilder</li>
              <li>
                reduzierte beziehungsweise statische Darstellung bei aktivierter
                Einstellung „Bewegung reduzieren“
              </li>
              <li>
                responsive Darstellung ohne notwendiges horizontales Scrollen
              </li>
            </ul>
            <h2>Prüfstatus</h2>
            <p>
              Eine vollständige manuelle und technische Prüfung aller Seiten und
              Funktionen ist noch nicht abgeschlossen. Deshalb geben wir derzeit
              keine Erklärung über eine vollständige oder teilweise Konformität
              mit WCAG 2.2 AA ab. Es können noch Barrieren bestehen.
            </p>
            <h2>Feedback und Kontakt</h2>
            <p>
              Wenn Ihnen eine Barriere auffällt, kontaktieren Sie uns bitte
              unter <a href={company.emailHref}>{company.email}</a> oder
              telefonisch unter <a href={company.phoneHref}>{company.phone}</a>.
              Beschreiben Sie nach Möglichkeit die betroffene Seite und das
              aufgetretene Problem. Wir bemühen uns um eine besser zugängliche
              Alternative.
            </p>
            <h2>Stand</h2>
            <p>
              31. August 2026. Der Hinweis wird nach Abschluss der Prüfung und
              vor der produktiven Aktivierung des Anfrageformulars aktualisiert.
            </p>
          </div>
        </>
      )
    }

    {
      section === 'bild-lizenznachweise' && (
        <>
          <header class="g-page-hero">
            <p class="g-eyebrow">
              <strong>Nachweise</strong> · Arbeitsstand
            </p>
            <h1>Bild- und Lizenznachweise</h1>
            <p>
              Dieses Verzeichnis dokumentiert die im Websiteentwurf verwendeten
              Medien und bekannte Lizenzgrundlagen.
            </p>
          </header>
          <div class="g-prose">
            <h2>Konzeptvisualisierungen</h2>
            <p>
              Die Architektur- und Technikvisualisierungen wurden im Rahmen des
              Websiteentwurfs mithilfe von OpenAI ImageGen erstellt. Sie zeigen
              keine realen Referenzprojekte, keine zugesicherten
              Ausführungsdetails und keine verbindlich dargestellten Produkte
              oder Hersteller.
            </p>
            <h2>Fotografien und Bestandsbilder</h2>
            <p>
              Einzelne Fotografien werden derzeit als Arbeits- und
              Platzhalterbilder aus dem bisherigen Webauftritt verwendet.
              Urheberschaft, abgebildete Personen und der konkrete
              Nutzungsumfang werden vor der endgültigen Veröffentlichung geprüft
              und dokumentiert.
            </p>
            <h2>Logo und Marken</h2>
            <p>
              Das Logo und die Bezeichnung „Elektro Hubmann“ werden für den
              Unternehmensauftritt verwendet. Etwaige Marken-, Kennzeichen- und
              Urheberrechte verbleiben bei den jeweiligen Rechteinhabern.
              Abgebildete Produktformen oder Gestaltungsmerkmale begründen keine
              Verbindung zu einem bestimmten Hersteller.
            </p>
            <h2>Schriften</h2>
            <p>
              Verwendet werden „Inter“ und „Inter Tight“, lokal eingebunden über
              <a href="https://fontsource.org/" rel="external">
                Fontsource
              </a>
              . Beide Schriftfamilien stehen unter der{' '}
              <a href="https://openfontlicense.org/" rel="external">
                SIL Open Font License 1.1
              </a>
              .
            </p>
            <h2>3D-Materialien</h2>
            <p>
              Ergänzende projektintern erzeugte 3D-Visualisierungen verwenden
              die Texturen{' '}
              <a
                href="https://polyhaven.com/a/concrete_wall_009"
                rel="external"
              >
                Concrete Wall 009
              </a>
              ,{' '}
              <a href="https://polyhaven.com/a/oak_veneer_01" rel="external">
                Oak Veneer 01
              </a>{' '}
              und{' '}
              <a href="https://polyhaven.com/a/grey_roof_01" rel="external">
                Grey Roof 01
              </a>{' '}
              von Poly Haven. Diese Materialien stehen unter{' '}
              <a href="https://polyhaven.com/license" rel="external">
                CC0
              </a>
              .
            </p>
            <h2>Hinweise zu Bildrechten</h2>
            <p>
              Hinweise zu Bild- oder Nutzungsrechten richten Sie bitte an{' '}
              <a href={company.emailHref}>{company.email}</a>.
            </p>
            <p>Stand: 31. August 2026.</p>
          </div>
        </>
      )
    }
  </main>
  <VariantGFooter baseUrl={baseUrl} />
  <script>
    const form = document.querySelector<HTMLFormElement>('.g-form');
    const status = document.querySelector<HTMLElement>('#form-status');
    const checkButton =
      document.querySelector<HTMLButtonElement>('#form-check');
    const checkForm = () => {
      if (!form) return;
      const file = form.elements.namedItem(
        'attachment',
      ) as HTMLInputElement | null;
      if (file?.files?.[0] && file.files[0].size > 10 * 1024 * 1024) {
        file.setCustomValidity('Die Datei darf maximal 10 MB groß sein.');
      } else {
        file?.setCustomValidity('');
      }
      if (!form.reportValidity()) return;
      status?.focus();
      status?.classList.add('is-ready');
      if (status)
        status.textContent =
          'Alle Pflichtfelder sind vollständig. Der Online-Versand ist noch nicht aktiviert – bitte senden Sie die Angaben per E-Mail oder rufen Sie uns an.';
    };
    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      checkForm();
    });
    checkButton?.addEventListener('click', checkForm);
  </script>
</BaseLayout>
